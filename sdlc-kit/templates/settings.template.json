{
  "model": "{{DEFAULT_MODEL}}",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .github/hooks/sdlc-tdd-guard.py pre-write",
            "timeout": 30,
            "statusMessage": "SDLC TDD guard"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .github/hooks/sdlc-tdd-guard.py observe-test",
            "timeout": 30,
            "statusMessage": "SDLC TDD guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .github/hooks/sdlc-tdd-guard.py stop-check",
            "timeout": 30,
            "statusMessage": "SDLC TDD guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c \"if [ -d .git ] && [ -f .github/hooks/sdlc-close-out.sh ]; then sh .github/hooks/sdlc-close-out.sh stop-check; fi\"",
            "timeout": 30,
            "statusMessage": "SDLC close-out backstop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .github/hooks/sdlc-tdd-guard.py observe-test",
            "timeout": 30,
            "statusMessage": "SDLC TDD guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh .github/hooks/sdlc-gate-claude.sh",
            "timeout": 120,
            "statusMessage": "{{HOOK_STATUS_MESSAGE}}"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh .github/hooks/sdlc-skill-ledger.sh",
            "timeout": 10,
            "statusMessage": "Recording skill activation"
          }
        ]
      }
    ]
  }
}
