{
  "model": "{{DEFAULT_MODEL}}",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\"; python .github/hooks/sdlc-tdd-guard.py pre-write",
            "timeout": 30,
            "statusMessage": "SDLC TDD guard"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\"; python .github/hooks/sdlc-tdd-guard.py observe-test",
            "timeout": 30,
            "statusMessage": "SDLC TDD guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\"; python .github/hooks/sdlc-tdd-guard.py stop-check",
            "timeout": 30,
            "statusMessage": "SDLC TDD guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\"; sh -c \"if [ -e .git ] && [ -f .github/hooks/sdlc-close-out.sh ]; then sh .github/hooks/sdlc-close-out.sh stop-check; elif grep -q 'stop_hook_active.: *true'; then :; else echo '{\\\"decision\\\":\\\"block\\\",\\\"reason\\\":\\\"SDLC close-out backstop did not run: .github/hooks/sdlc-close-out.sh was not found from '\\\"\\$PWD\\\"'. If that is below the project root, a shell cd moved this session: cd back to the root and finish. Otherwise the script is missing and no commit in this session was checked for its close-out record. Tell the owner.\\\"}'; fi\"",
            "timeout": 30,
            "statusMessage": "SDLC close-out backstop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\"; python .github/hooks/sdlc-tdd-guard.py observe-test",
            "timeout": 30,
            "statusMessage": "SDLC TDD guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\"; sh .github/hooks/sdlc-gate-claude.sh",
            "timeout": 120,
            "statusMessage": "{{HOOK_STATUS_MESSAGE}}"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\"; sh .github/hooks/sdlc-skill-ledger.sh",
            "timeout": 10,
            "statusMessage": "Recording skill activation"
          }
        ]
      }
    ]
  }
}
