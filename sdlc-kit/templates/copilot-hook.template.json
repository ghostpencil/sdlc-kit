{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit|create|apply_patch",
        "cwd": ".",
        "timeoutSec": 120,
        "bash": "if [ -e .git ] && [ -f .github/hooks/sdlc-gate.sh ]; then cat | sh .github/hooks/sdlc-gate.sh; fi"
      }
    ]
  }
}
